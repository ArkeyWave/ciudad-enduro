#!/usr/bin/env bash
# ce-oss-deploy v3 — the ONLY command a CI deploy key can run on vops-infra.
# Installed at /usr/local/bin/ce-oss-deploy (root 755). The target is fixed per key in
# /root/.ssh/authorized_keys; the caller can never choose it:
#   restrict,command="/usr/local/bin/ce-oss-deploy staging" ssh-ed25519 AAAA... ci-deploy@ciudad-enduro-oss
#   restrict,command="/usr/local/bin/ce-oss-deploy production" ssh-ed25519 AAAA... ci-deploy-prod@ciudad-enduro-oss
#
# Input: SSH_ORIGINAL_COMMAND
#   staging:    "<sha> <api-digest> <web-digest>": a commit on main and the manifest digests of
#               the two images CI built, checked and pushed to GHCR for it;
#   production: "<sha>" only. The digests come from the staging promotion record of <sha>, so
#               production runs only a pair that passed staging.
# Effect, in order, stopping at the first failure:
#   1. refuses a SHA that is not on main, and a rollback (see below);
#   2. preflight of BOTH images before either app is touched: pull by digest, GitHub build
#      provenance attestation (ci.yml on refs/heads/main, source commit = <sha>, GitHub-hosted
#      runner), revision label = <sha>;
#   3. deploys api, then web, by digest through Coolify (pull, no build), and checks that each
#      app runs exactly the pulled image;
#   4. origin lock, live revision and home page;
#   5. staging writes the promotion record /var/lib/ce-oss/promoted/<sha> (production deploys
#      only a recorded pair); production writes its own record /var/lib/ce-oss/production/<sha>.
# Nothing from the repo is built or run on the box except the attested images themselves.
#
# Rollback to an older main commit is refused unless an operator on the box sets ROLLBACK=1
# (sshd passes no such variable from the CI key). A GitHub or Sigstore outage blocks every
# deploy, ROLLBACK=1 included (fail closed).
#
# PRIVATE=1 (operator only, like ROLLBACK=1): a deploy that no public router serves. Both apps
# must store the label traefik.enable=false (and keep their hand-written labels) before the
# deploy; right after each app's deploy its containers must carry it, publish no host port, be
# on the coolify network and answer on their IP there (step 4). Any failure after the first
# change stops both apps.
#
# Every run is detached from the SSH session (setsid) and logs to
# /var/lib/ce-oss/logs/<target>-<sha>-<utc>.log; the caller streams the log and gets the run's
# exit code. A dropped connection or a cancelled CI job does not stop the run.
set -euo pipefail
umask 077

REPO_URL=https://github.com/ArkeyWave/ciudad-enduro.git
API_REPO=ghcr.io/arkeywave/ciudad-enduro-api
WEB_REPO=ghcr.io/arkeywave/ciudad-enduro-web
GH=/usr/local/lib/ce-oss/gh/bin/gh
GH_TOKEN_FILE=/root/.secrets/ce-oss-gh-attest.env
STATE=/var/cache/ce-oss-deploy
CACHE=$STATE/repo.git
PROMOTED=/var/lib/ce-oss/promoted
PROD_DEPLOYED=/var/lib/ce-oss/production
BOX_IP=104.152.209.8
REVISION=org.opencontainers.image.revision

refuse() { echo "refused: $1" >&2; exit 2; }
die() { echo "FAIL $*" >&2; exit 1; }
log() { echo "[$(date -u +%H:%M:%S)] $*"; }

target=${1:-}
case "$target" in
  staging) API_UUID=c6mm7pwdmoysv0eg2vgwo4bi WEB_UUID=whfatie8ek3wh09ite3mnqn0 HOST=enduro-next.vops.pe
    RECORDS=$PROMOTED ;;
  production) API_UUID=ith1im25jwpamnvthlikfglq WEB_UUID=gwn5ys9bnjvn7fasm6egvxw4 HOST=enduro.vops.pe
    RECORDS=$PROD_DEPLOYED ;;
  *) refuse "unknown target '$target'" ;;
esac
API_PORT=3001 WEB_PORT=3000
private=0; [ "${PRIVATE:-}" = 1 ] && private=1

request=${SSH_ORIGINAL_COMMAND:-}
re='^([0-9a-f]{40}) (sha256:[0-9a-f]{64}) (sha256:[0-9a-f]{64})$'
if [ "$target" = staging ]; then
  [[ $request =~ $re ]] || refuse "expected '<40-hex sha> sha256:<64-hex api digest> sha256:<64-hex web digest>'"
  sha=${BASH_REMATCH[1]} api_digest=${BASH_REMATCH[2]} web_digest=${BASH_REMATCH[3]}
else
  [[ $request =~ ^[0-9a-f]{40}$ ]] || refuse "expected '<40-hex sha>'"
  sha=$request
fi

# The run is detached from the SSH session: a cancelled CI job or a dropped connection must not
# stop it halfway. The caller's process starts the run in its own session with its output in a
# log, streams that log back and exits with the run's code (the last line "END exit=<code>").
# sshd passes no CE_OSS_RUN from a key, so only the detached run itself has it.
LOGS=/var/lib/ce-oss/logs
if [ -z "${CE_OSS_RUN:-}" ]; then
  install -d -m 700 "$LOGS"
  run_log=$LOGS/$target-$sha-$(date -u +%Y%m%dT%H%M%SZ).log
  : > "$run_log"
  # A background job of a non-interactive shell is no process group leader, so setsid does not
  # fork again and $! is the run's own PID.
  CE_OSS_RUN=$run_log setsid bash "$0" "$target" < /dev/null >> "$run_log" 2>&1 &
  run_pid=$!
  echo "run $run_pid, log $run_log"
  tail -n +1 -f --pid="$run_pid" "$run_log" || true
  code=$(sed -n 's/^END exit=\([0-9]\{1,3\}\)$/\1/p' "$run_log" | tail -1)
  exit "${code:-1}"
fi

changed=0
on_exit() {
  local rc=$?
  trap - EXIT
  # In private mode any failure after the first change stops both apps (a die in either deploy,
  # a timeout, a cancelled Coolify deployment, a failed check).
  if [ "$rc" != 0 ] && [ $private = 1 ] && [ $changed = 1 ]; then
    stop_app "$API_UUID" api || true
    stop_app "$WEB_UUID" web || true
    echo "FAIL private: run failed after a change; both apps stopped" >&2
  fi
  echo "END exit=$rc"
  exit "$rc"
}
trap on_exit EXIT

install -d -m 700 "$STATE"
exec 9>"$STATE/lock.$target"
flock -w 1800 9 || refuse "another $target deploy held the lock for 30 min"

# Production takes the digests from the staging promotion record of the SHA, never from the caller.
if [ "$target" = production ]; then
  record=$PROMOTED/$sha
  [ -f "$record" ] || refuse "$sha has no staging promotion record"
  read -r r_sha r_api r_web _ < "$record" || refuse "cannot read $record"
  [[ "$r_sha $r_api $r_web" =~ $re ]] && [ "$r_sha" = "$sha" ] || refuse "$record is malformed"
  api_digest=$r_api web_digest=$r_web
  log "staging promotion record: api $api_digest, web $web_digest"
fi

# Only commits reachable from main can deploy. The cache fetches main only, so a fork or
# branch commit is not even present here.
# The cache is shared by both targets: one fetch at a time.
exec 8>"$STATE/lock.cache"
flock -w 300 8 || refuse "the repo cache lock was held for 5 min"
[ -d "$CACHE" ] || git init -q --bare "$CACHE"
git -C "$CACHE" fetch -q --prune "$REPO_URL" '+refs/heads/main:refs/remotes/origin/main'
exec 8>&-
git -C "$CACHE" cat-file -e "$sha^{commit}" 2>/dev/null || refuse "$sha is not on main"
git -C "$CACHE" merge-base --is-ancestor "$sha" refs/remotes/origin/main || refuse "$sha is not on main"

running_containers() { # APP_UUID -> IDs of its running containers
  docker ps --filter "name=^$1-" --filter status=running --format '{{.ID}}'
}
latest_container() { # APP_UUID -> ID of its newest container in any state, empty when none
  docker ps -a --latest --filter "name=^$1-" --format '{{.ID}}'
}
app_images() { # APP_UUID -> sorted image IDs of its running containers
  local c
  for c in $(running_containers "$1"); do docker inspect -f '{{.Image}}' "$c"; done | sort -u
}
label_of() { # IMAGE -> its revision label, empty when absent
  docker image inspect "$1" -f "{{with .Config.Labels}}{{index . \"$REVISION\"}}{{end}}" 2>/dev/null || true
}

newest_record() { # -> SHA of the target's record with the newest UTC date (field 4), empty when none
  local f s d
  for f in "$RECORDS"/*; do
    [[ ${f##*/} =~ ^[0-9a-f]{40}$ ]] || continue
    read -r s _ _ d < "$f" || continue
    [[ $s = "${f##*/}" && $d =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] && echo "$d $s"
  done | sort | tail -1 | cut -d' ' -f2
}

# Rollback guard: the lower bound is the revision label of the image of the newest api container,
# in any state (a stopped or restarting api still counts). An image without the label (a Coolify
# build before v2) is refused unless ROLLBACK=1. A Coolify stop removes the containers, so with no
# api container at all the bound is the target's newest record (by its UTC date: staging the
# promotion records, production its own deploy records); no record either passes (the first deploy). A bound that is not on main, or a SHA older than the bound,
# is refused unless ROLLBACK=1.
live=$(latest_container "$API_UUID")
if [ -n "$live" ]; then
  live_sha=$(label_of "$(docker inspect -f '{{.Image}}' "$live")") from="the deployed"
  if ! [[ $live_sha =~ ^[0-9a-f]{40}$ ]]; then
    [ "${ROLLBACK:-}" = 1 ] || refuse "the api image has no $REVISION label; an operator on the box sets ROLLBACK=1"
    log "ROLLBACK=1: the api image has no revision label"
  fi
else
  live_sha=$(newest_record) from="the newest $target record"
fi
if [[ $live_sha =~ ^[0-9a-f]{40}$ ]] && [ "$live_sha" != "$sha" ]; then
  if ! git -C "$CACHE" cat-file -e "$live_sha^{commit}" 2>/dev/null; then
    # A bound that is not on main cannot be ordered; never let it pass silently.
    [ "${ROLLBACK:-}" = 1 ] || refuse "$from $live_sha is not on main; an operator on the box sets ROLLBACK=1"
    log "ROLLBACK=1: $from $live_sha is not on main"
  elif git -C "$CACHE" merge-base --is-ancestor "$sha" "$live_sha"; then
    [ "${ROLLBACK:-}" = 1 ] || refuse "$sha is older than $from $live_sha; an operator on the box sets ROLLBACK=1 to roll back"
    log "ROLLBACK=1: rolling back from $live_sha"
  fi
fi

# Preflight: both images before either app changes. The token (fine-grained, no permissions)
# only lets gh read public attestations; it enters gh's environment and no argv.
preflight() { # NAME REPO DIGEST
  local name=$1 ref=$2@$3 token rev
  docker pull -q "$ref" >/dev/null || refuse "$name: cannot pull $ref"
  token=$(grep '^GH_TOKEN=' "$GH_TOKEN_FILE" | cut -d= -f2-) || refuse "no GH_TOKEN in $GH_TOKEN_FILE"
  GH_TOKEN=$token "$GH" attestation verify "oci://$ref" \
    --repo ArkeyWave/ciudad-enduro \
    --signer-workflow ArkeyWave/ciudad-enduro/.github/workflows/ci.yml \
    --source-ref refs/heads/main --source-digest "$sha" \
    --deny-self-hosted-runners >/dev/null ||
    refuse "$name: $ref has no build provenance attestation from ci.yml on main for $sha"
  rev=$(label_of "$ref")
  [ "$rev" = "$sha" ] || refuse "$name: $ref has revision label '${rev:-none}', expected $sha"
  log "$name: $ref pulled, attested for $sha, label ok"
}
preflight api "$API_REPO" "$api_digest"
preflight web "$WEB_REPO" "$web_digest"

# Both apps must deploy a registry image. Any other build pack would ignore the digest PATCH and
# build from source on the box.
build_pack_of() { docker exec coolify-db psql -U coolify -d coolify -tAc "select build_pack from applications where uuid='$1'"; }
for app in "$API_UUID" "$WEB_UUID"; do
  bp=$(build_pack_of "$app")
  [ "$bp" = dockerimage ] || refuse "app $app has build pack '${bp:-none}', expected dockerimage"
done

# Coolify stores custom_labels base64. With the read-only label setting on, Coolify would
# generate its own labels and ignore the stored ones.
stored_labels() { docker exec coolify-db psql -U coolify -d coolify -tAc "select custom_labels from applications where uuid='$1'" | base64 -d; }
label_readonly_of() {
  docker exec coolify-db psql -U coolify -d coolify -tAc \
    "select s.is_container_label_readonly_enabled from application_settings s join applications a on a.id = s.application_id where a.uuid='$1'"
}

# Checks before the first change (called right before the first Coolify call): both apps keep
# their hand-written labels; PRIVATE=1: both store exactly one traefik.enable label, =false;
# public mode: no other running container claims the host (an old app must be stopped first).
prechange_checks() {
  local app ro labels
  for app in "$API_UUID" "$WEB_UUID"; do
    ro=$(label_readonly_of "$app") || refuse "app $app: cannot read its label setting"
    [ "$ro" = f ] || refuse "app $app has is_container_label_readonly_enabled '${ro:-none}', expected f"
  done
  if [ $private = 1 ]; then
    for app in "$API_UUID" "$WEB_UUID"; do
      labels=$(stored_labels "$app") || refuse "app $app: cannot read its stored labels"
      [ "$(grep -E '^traefik\.enable=' <<<"$labels")" = traefik.enable=false ] ||
        refuse "PRIVATE=1: app $app does not store exactly one traefik.enable=false label"
    done
    log "PRIVATE=1: both apps store traefik.enable=false, label setting not read-only"
  else
    host_owners_ok || refuse "another running container claims $HOST; stop it first"
    log "before the deploy: only these apps claim $HOST"
  fi
}

# Coolify API on loopback inside the coolify container. The token goes in on stdin and
# into a curl config file there, never into any argv.
capi() { # METHOD PATH [json]
  local token
  token=$(grep '^COOLIFY_API_TOKEN=' /root/.secrets/coolify-vops-infra.env | cut -d= -f2-)
  { printf '%s\n' "$token"; printf '%s' "${3:-}"; } | docker exec -i coolify sh -c '
    umask 077; read -r T; cfg=$(mktemp); trap "rm -f \"\$cfg\"" EXIT
    printf "header = \"Authorization: Bearer %s\"\n" "$T" > "$cfg"; unset T
    if [ -n "$2" ]; then data="--data-binary @-"; else data=""; fi
    curl -sS --fail-with-body -K "$cfg" -X "$0" -H "Accept: application/json" \
      -H "Content-Type: application/json" $data "http://127.0.0.1:8080/api/v1$1"' "$1" "$2" "${3:+1}"
}

stop_app() { # APP_UUID NAME
  log "$2: stopping $1"
  capi POST "/applications/$1/stop" >/dev/null || echo "FAIL $2: could not stop $1, stop it by hand" >&2
}

deploy_status() { # DEPLOYMENT_UUID -> its Coolify queue status
  docker exec coolify-db psql -U coolify -d coolify -tAc \
    "select status from application_deployment_queues where deployment_uuid='$1'"
}

# Deploys one app by digest, then requires every running container of it to run exactly the
# pulled image. If the old image (running before this deploy) still runs, the rolling update
# failed and the old container stays. Any other image is unchecked: the app is stopped.
deploy() { # APP_UUID NAME REPO DIGEST
  local uuid=$1 name=$2 repo=$3 digest=$4 dep status=queued want before got id
  before=$(app_images "$uuid")
  capi PATCH "/applications/$uuid" \
    "{\"docker_registry_image_name\":\"$repo\",\"docker_registry_image_tag\":\"sha256-${digest#sha256:}\"}" >/dev/null
  dep=$(capi POST "/deploy?uuid=$uuid" | jq -r '.deployments[0].deployment_uuid // empty')
  [[ $dep =~ ^[A-Za-z0-9]+$ ]] || die "$name: Coolify queued no deployment"
  log "$name: deployment $dep queued ($repo@$digest)"
  for _ in $(seq 180); do
    status=$(deploy_status "$dep")
    case "$status" in
      finished) break ;;
      failed|cancelled*|error) die "$name: deployment $dep $status" ;;
    esac
    sleep 10
  done
  [ "$status" = finished ] || die "$name: deployment $dep still '$status' after 30 min"
  want=$(docker image inspect "$repo@$digest" -f '{{.Id}}')
  got=$(app_images "$uuid")
  # Two passes, so the result does not depend on the order of the IDs: an unchecked image first.
  for id in $got; do
    [ "$id" = "$want" ] || grep -qxF "$id" <<<"$before" && continue
    stop_app "$uuid" "$name"
    die "$name: unchecked image $id runs, expected $want ($repo@$digest); app stopped"
  done
  for id in $got; do
    [ "$id" = "$want" ] || die "$name: the old image $id still runs, expected $want ($repo@$digest)"
  done
  [ -n "$got" ] || die "$name: no running container, expected $want ($repo@$digest)"
  log "$name: finished, running $repo@$digest"
}

# The origin must still answer only Cloudflare, and nothing may publish a host port.
origin_lock_ok() {
  local path code uuid c labels routers r
  for path in / /api/health; do
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 --resolve "$HOST:443:$BOX_IP" "https://$HOST$path" || true)
    [ "$code" = 403 ] || { echo "FAIL origin lock: direct https://$HOST$path answered $code, expected 403" >&2; return 1; }
  done
  for uuid in "$API_UUID" "$WEB_UUID"; do
    c=$(docker ps --filter "name=^$uuid-" --filter status=running --format '{{.Names}}')
    [ -n "$c" ] || { echo "FAIL origin lock: no running container for $uuid" >&2; return 1; }
    for c in $c; do
      labels=$(docker inspect "$c" -f '{{range $k,$v := .Config.Labels}}{{$k}}={{$v}}{{"\n"}}{{end}}')
      routers=$(grep -oE '^traefik\.http\.routers\.[^.=]+\.rule=' <<<"$labels" | cut -d. -f4 || true)
      [ -n "$routers" ] || { echo "FAIL origin lock: $c has no traefik router" >&2; return 1; }
      for r in $routers; do
        grep -qE "^traefik\.http\.routers\.$r\.middlewares=(.*,)?cloudflare-only@file(,|$)" <<<"$labels" ||
          { echo "FAIL origin lock: router $r on $c lacks cloudflare-only@file" >&2; return 1; }
      done
      [ -z "$(docker port "$c")" ] || { echo "FAIL origin lock: $c publishes a host port" >&2; return 1; }
    done
  done
}

# Every running container on the box whose labels name the host (the router rule's fixed
# string) must be one of the two apps: an old app that still claims the host fails the deploy.
host_owners_ok() {
  local want got c values rule="Host(\`$HOST\`)"
  want=$({ running_containers "$API_UUID"; running_containers "$WEB_UUID"; } | sort)
  # The labels go into a variable first: with pipefail, grep -q closing the pipe early would
  # turn a match into a SIGPIPE failure of docker inspect.
  got=$(for c in $(docker ps -q); do
    values=$(docker inspect "$c" -f '{{range $k,$v := .Config.Labels}}{{$v}}{{"\n"}}{{end}}') || values=""
    grep -qF "$rule" <<<"$values" && echo "$c"
  done | sort)
  [ "$got" = "$want" ] ||
    { echo "FAIL host: running containers with $rule: $(echo $got); expected $(echo $want)" >&2; return 1; }
}

# PRIVATE=1, right after each app's deploy: every running container keeps Traefik off, publishes
# no host port, is on the coolify network and answers on its own IP there (api: revision = SHA;
# web: home 200), so a crashed new container behind an old one cannot hide. A failure dies; the
# exit trap then stops both apps.
private_app_ok() { # NAME APP_UUID
  local name=$1 uuid=$2 c ip got ok seen
  c=$(running_containers "$uuid")
  [ -n "$c" ] || die "private: $name has no running container"
  for c in $c; do
    [ "$(docker inspect "$c" -f '{{index .Config.Labels "traefik.enable"}}')" = false ] ||
      die "private: $name container $c does not carry traefik.enable=false"
    [ -z "$(docker port "$c")" ] || die "private: $name container $c publishes a host port"
    ip=$(docker inspect "$c" -f '{{with index .NetworkSettings.Networks "coolify"}}{{.IPAddress}}{{end}}')
    [[ $ip =~ ^[0-9.]+$ ]] || die "private: $name container $c is not on the coolify network"
  done
  for _ in $(seq 18); do
    ok=1 seen=""
    for c in $(running_containers "$uuid"); do
      ip=$(docker inspect "$c" -f '{{with index .NetworkSettings.Networks "coolify"}}{{.IPAddress}}{{end}}')
      if [ "$name" = api ]; then
        got=$(curl -fsS --max-time 10 "http://$ip:$API_PORT/api/health" | jq -r '.revision // empty' || true)
        [ "$got" = "$sha" ] || ok=0
        seen+=" $ip revision=${got:-none}"
      else
        got=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "http://$ip:$WEB_PORT/" || true)
        [ "$got" = 200 ] || ok=0
        seen+=" $ip home=${got:-none}"
      fi
    done
    [ $ok = 1 ] && break
    sleep 10
  done
  [ $ok = 1 ] || die "private: $name$seen (expected revision $sha, home 200)"
  log "private: $name$seen, traefik.enable=false, no host port"
}

[ $private = 1 ] && log "PRIVATE=1: no public check; the checks run on the container IPs"
log "deploying $sha to $target"
prechange_checks
changed=1
deploy "$API_UUID" api "$API_REPO" "$api_digest"
[ $private = 1 ] && private_app_ok api "$API_UUID"
deploy "$WEB_UUID" web "$WEB_REPO" "$web_digest"
[ $private = 1 ] && private_app_ok web "$WEB_UUID"

if [ $private = 0 ]; then
  if ! origin_lock_ok || ! host_owners_ok; then
    stop_app "$API_UUID" api
    stop_app "$WEB_UUID" web
    die "public checks failed; both apps stopped"
  fi
  log "origin lock: direct 403 for / and /api/health, every router has cloudflare-only@file, no host ports, only these apps claim $HOST"

  # A crashed new container behind an old one would still answer: compare the revision, and
  # wait for the home page in the same loop.
  revision=""; home=""
  for _ in $(seq 18); do
    revision=$(curl -fsS --max-time 10 "https://$HOST/api/health" | jq -r '.revision // empty' || true)
    home=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "https://$HOST/" || true)
    [ "$revision" = "$sha" ] && [ "$home" = 200 ] && break
    sleep 10
  done
  [ "$revision" = "$sha" ] && [ "$home" = 200 ] ||
    die "live revision is '${revision:-none}' (expected $sha), home answered '${home:-none}'"
  log "live: https://$HOST/api/health revision=$revision, home 200"
fi

# Record of the deploy, written by rename so a reader never sees a partial file. Staging: the
# promotion record (production deploys only a pair that passed here); a PRIVATE=1 staging deploy
# promotes nothing. Production: the lower bound of its own rollback guard.
if [ "$target" = staging ] && [ $private = 1 ]; then
  log "PRIVATE=1: no promotion record"
  exit 0
fi
install -d -m 700 "$RECORDS"
tmp=$(mktemp "$RECORDS/.$sha.XXXXXX")
printf '%s %s %s %s\n' "$sha" "$api_digest" "$web_digest" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$tmp"
mv -f "$tmp" "$RECORDS/$sha"
log "recorded: $RECORDS/$sha"
