#!/usr/bin/env bash
# ce-oss-deploy — the ONLY command the CI deploy key can run on vops-infra.
# Installed at /usr/local/bin/ce-oss-deploy (root 755). authorized_keys line:
#   restrict,command="/usr/local/bin/ce-oss-deploy" ssh-ed25519 AAAA... ci-deploy@ciudad-enduro-oss
#
# Input: SSH_ORIGINAL_COMMAND = a 40-hex commit SHA that is on origin/main.
# Effect: builds and deploys that commit to staging (api, then web), then proves it is live.
set -euo pipefail
umask 077

REPO_URL=https://github.com/ArkeyWave/ciudad-enduro.git
CACHE=/var/cache/ce-oss-deploy/repo.git
LOCK=/run/lock/ce-oss-deploy.lock
API_UUID=c6mm7pwdmoysv0eg2vgwo4bi
WEB_UUID=whfatie8ek3wh09ite3mnqn0
HOST=enduro-next.vops.pe

refuse() { echo "refused: $1" >&2; exit 2; }
log() { echo "[$(date -u +%H:%M:%S)] $*"; }

sha=${SSH_ORIGINAL_COMMAND:-}
[[ $sha =~ ^[0-9a-f]{40}$ ]] || refuse "expected one 40-hex commit SHA"

exec 9>"$LOCK"
flock -w 1800 9 || refuse "another deploy held the lock for 30 min"

# Only commits reachable from main can deploy. The cache fetches main only, so a fork or
# branch commit is not even present here.
[ -d "$CACHE" ] || git init -q --bare "$CACHE"
git -C "$CACHE" fetch -q --prune "$REPO_URL" '+refs/heads/main:refs/remotes/origin/main'
git -C "$CACHE" cat-file -e "$sha^{commit}" 2>/dev/null || refuse "$sha is not on main"
git -C "$CACHE" merge-base --is-ancestor "$sha" refs/remotes/origin/main || refuse "$sha is not on main"

# Coolify API on loopback inside the coolify container; the token travels on stdin.
capi() { # METHOD PATH [json]
  local token
  token=$(grep '^COOLIFY_API_TOKEN=' /root/.secrets/coolify-vops-infra.env | cut -d= -f2-)
  { printf '%s\n' "$token"; printf '%s' "${3:-}"; } | docker exec -i coolify sh -c '
    read -r T
    if [ -n "$2" ]; then data="--data-binary @-"; else data=""; fi
    curl -sS --fail-with-body -X "$0" -H "Authorization: Bearer $T" -H "Accept: application/json" \
      -H "Content-Type: application/json" $data "http://127.0.0.1:8080/api/v1$1"' "$1" "$2" "${3:+1}"
}

deploy() { # APP_UUID NAME
  local uuid=$1 name=$2 dep status
  capi PATCH "/applications/$uuid" "{\"git_commit_sha\":\"$sha\"}" >/dev/null
  dep=$(capi POST "/deploy?uuid=$uuid" | jq -r '.deployments[0].deployment_uuid // empty')
  [ -n "$dep" ] || { echo "FAIL $name: Coolify queued no deployment" >&2; exit 1; }
  log "$name: deployment $dep queued"
  for _ in $(seq 180); do
    status=$(docker exec coolify-db psql -U coolify -d coolify -tAc \
      "select status from application_deployment_queues where deployment_uuid='$dep'")
    case "$status" in
      finished) log "$name: finished"; return 0 ;;
      failed|cancelled*|error) echo "FAIL $name: deployment $dep $status" >&2; exit 1 ;;
    esac
    sleep 10
  done
  echo "FAIL $name: deployment $dep still '$status' after 30 min" >&2
  exit 1
}

log "deploying $sha"
deploy "$API_UUID" api
deploy "$WEB_UUID" web

# The image Coolify built must pass the same path check as CI, with the script from this commit.
verify=$(mktemp)
trap 'rm -f "$verify"' EXIT
git -C "$CACHE" show "$sha:scripts/verify-image.sh" > "$verify"
bash "$verify" "$API_UUID:$sha"
bash "$verify" "$WEB_UUID:$sha"

# A crashed new container behind an old one would still answer: compare the revision.
for _ in $(seq 18); do
  revision=$(curl -fsS --max-time 10 "https://$HOST/api/health" | jq -r '.revision // empty' || true)
  if [ "$revision" = "$sha" ]; then
    curl -fsS --max-time 10 -o /dev/null "https://$HOST/" || { echo "FAIL web: home page did not answer 200" >&2; exit 1; }
    log "live: https://$HOST/api/health revision=$revision, home 200"
    exit 0
  fi
  sleep 10
done
echo "FAIL live revision is '${revision:-none}', expected $sha" >&2
exit 1
