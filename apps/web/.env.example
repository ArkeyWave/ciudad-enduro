# Web environment. Copy to apps/web/.env.local for `pnpm dev`.
# Base URL the server uses to reach the API (also the target of the dev-only /api rewrite).
API_INTERNAL_URL=http://localhost:3001
# Turnstile widget site key, read at runtime by /ingresar (one widget per host). This is
# Cloudflare's always-pass test key; see README, Turnstile.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
