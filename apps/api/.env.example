# API environment. Copy to apps/api/.env for `pnpm dev`; the API loads that file itself.
# Every secret here starts with "dev-": production refuses such values.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5434/ciudad_enduro
WEB_ORIGIN=http://localhost:3000
BETTER_AUTH_SECRET=dev-better-auth-secret-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3000
RESEND_API_KEY=dev-resend-api-key
EMAIL_FROM="Ciudad Enduro <no-reply@example.com>"
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret
OTP_HMAC_SECRET=dev-otp-hmac-secret-0123456789abcdef0
# Cloudflare's always-pass test secret: production refuses it. Cloudflare reports hostname
# example.com and no action for it, so the send path refuses its tokens (README, Turnstile).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
BUILD_SHA=unknown
# Elevations for a GPX without <ele> (plan §8 G5)
ELEVATION_API_URL=https://api.open-meteo.com/v1/elevation
# Photo storage (plan §9 V1, V6). Dev: the S3 mock of docker-compose.dev.yml (no auth, path-style).
# Production: R2_ACCOUNT_ID instead of S3_ENDPOINT, the keys only in Coolify.
S3_ENDPOINT=http://localhost:9090
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=dev-access-key-id
R2_SECRET_ACCESS_KEY=dev-secret-access-key
R2_MEDIA_BUCKET=ciudad-enduro-media
MEDIA_PUBLIC_BASE_URL=http://localhost:9090/ciudad-enduro-media
# Staging shares the bucket under "staging/"; production leaves it empty.
MEDIA_KEY_PREFIX=
