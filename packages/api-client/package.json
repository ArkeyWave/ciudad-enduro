{
  "name": "api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --typecheck.only"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@ciudad-enduro/config": "workspace:*",
    "eslint": "10.14.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
