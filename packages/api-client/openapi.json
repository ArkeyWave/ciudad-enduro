  "info": {
    "contact": {},
    "description": "",
    "title": "Ciudad Enduro API",
    "version": "0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/admin/photos": {
      "get": {
        "operationId": "PhotosController_queue",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TrailStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QueuePhotoDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Not an admin"
          }
        },
        "tags": [
          "photos"
        ]
      }
    },
    "/api/admin/trails": {
      "get": {
        "operationId": "TrailListsController_queue",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TrailStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QueueTrailDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Not an admin"
          }
        },
        "tags": [
          "trails"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "MeController_get",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/me/trails": {
      "get": {
        "operationId": "TrailListsController_mine",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MyTrailDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          }
        },
        "tags": [
          "trails"
        ]
      }
    },
    "/api/photos": {
      "post": {
        "operationId": "PhotosController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreatePhotoBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "NO_POSITION (no body position and no EXIF GPS), PHOTO_INVALID, or a validation error"
          },
          "401": {
            "description": "No valid session"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "Over 10 MiB, or PHOTO_TOO_LARGE: over 50 megapixels"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "PHOTO_TYPE: not a JPEG, PNG or WebP"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "NO_TRAIL_NEARBY: no published trail within 50 m"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "TOO_MANY_UPLOADS: a non-admin made 10 uploads (trails and photos) in 10 min; TOO_MANY_PENDING: 20 photos in review"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "ENCODE_BUSY or STORAGE_UNAVAILABLE; try again"
          }
        },
        "tags": [
          "photos"
        ]
      }
    },
    "/api/photos/{id}": {
      "patch": {
        "operationId": "PhotosController_update",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePhotoDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoDto"
                }
              }
            },
            "description": ""
