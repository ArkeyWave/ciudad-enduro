            "description": "WebP, 160 px square",
            "type": "string"
          },
          "trailName": {
            "type": "string"
          },
          "trailSlug": {
            "type": "string"
          },
          "url": {
            "description": "WebP, at most 1600 px",
            "type": "string"
          },
          "width": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "status",
          "lineFraction",
          "position",
          "heading",
          "takenAt",
          "url",
          "thumbUrl",
          "width",
          "height",
          "trailSlug",
          "trailName"
        ],
        "type": "object"
      },
      "QueuePhotoDto": {
        "properties": {
          "authorEmail": {
            "description": "Null when the author was deleted",
