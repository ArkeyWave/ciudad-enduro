{
  "components": {
    "schemas": {
      "City": {
        "enum": [
          "Chimbote",
          "Nuevo Chimbote",
          "Trujillo"
        ],
        "type": "string"
      },
      "CoordinatesDto": {
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "type": "object"
      },
      "CreateTrailBody": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "gpx": {
            "description": "One GPX file, at most 10 MiB",
            "format": "binary",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "name",
          "city",
          "difficulty",
          "type",
          "gpx"
        ],
        "type": "object"
      },
      "Difficulty": {
        "enum": [
          "facil",
          "intermedio",
          "dificil"
        ],
        "type": "string"
      },
      "ErrorBodyDto": {
        "properties": {
          "code": {
            "example": "TOO_MANY_PENDING",
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "slug": {
            "description": "GPX_DUPLICATE only, when the uploader may see that trail",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "MeDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "type": "object"
      },
      "MyTrailDto": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "distanceM": {
            "nullable": true,
            "type": "number"
          },
          "elevationGainM": {
            "nullable": true,
            "type": "number"
          },
          "elevationLossM": {
            "nullable": true,
            "type": "number"
          },
          "elevationProfile": {
            "description": "[distance_m, ele_m] pairs, at most 300",
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "nullable": true,
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "start": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailStatus"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "city",
          "difficulty",
          "type",
          "start",
          "distanceM",
          "elevationGainM",
          "elevationLossM",
          "elevationProfile",
          "status"
        ],
        "type": "object"
      },
      "QueueTrailDto": {
        "properties": {
          "authorEmail": {
            "description": "Null when the author was deleted",
            "nullable": true,
            "type": "string"
          },
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "distanceM": {
            "nullable": true,
            "type": "number"
          },
          "elevationGainM": {
            "nullable": true,
            "type": "number"
          },
          "elevationLossM": {
            "nullable": true,
            "type": "number"
          },
          "elevationProfile": {
            "description": "[distance_m, ele_m] pairs, at most 300",
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "nullable": true,
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "start": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailStatus"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "city",
          "difficulty",
          "type",
          "start",
          "distanceM",
          "elevationGainM",
          "elevationLossM",
          "elevationProfile",
          "status",
          "authorEmail"
        ],
        "type": "object"
      },
      "TrailDetailDto": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "distanceM": {
            "nullable": true,
            "type": "number"
          },
          "elevationGainM": {
            "nullable": true,
            "type": "number"
          },
          "elevationLossM": {
            "nullable": true,
            "type": "number"
          },
          "elevationMaxM": {
            "nullable": true,
            "type": "number"
          },
          "elevationMinM": {
            "nullable": true,
            "type": "number"
          },
          "elevationProfile": {
            "description": "[distance_m, ele_m] pairs, at most 300",
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "nullable": true,
            "type": "array"
          },
          "end": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CoordinatesDto"
              }
            ],
            "nullable": true,
            "type": "object"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "path": {
            "description": "[lng, lat] pairs, simplified for display",
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "nullable": true,
            "type": "array"
          },
          "slug": {
            "type": "string"
          },
          "start": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailStatus"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "city",
          "difficulty",
          "type",
          "start",
          "distanceM",
          "elevationGainM",
          "elevationLossM",
          "elevationProfile",
          "status",
          "description",
          "end",
          "path",
          "elevationMinM",
          "elevationMaxM"
        ],
        "type": "object"
      },
      "TrailStatus": {
        "enum": [
          "draft",
          "published",
          "hidden"
        ],
        "type": "string"
      },
      "TrailSummaryDto": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "distanceM": {
            "nullable": true,
            "type": "number"
          },
          "elevationGainM": {
            "nullable": true,
            "type": "number"
          },
          "elevationLossM": {
            "nullable": true,
            "type": "number"
          },
          "elevationProfile": {
            "description": "[distance_m, ele_m] pairs, at most 300",
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "nullable": true,
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "start": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "city",
          "difficulty",
          "type",
          "start",
          "distanceM",
          "elevationGainM",
          "elevationLossM",
          "elevationProfile"
        ],
        "type": "object"
      },
      "TrailType": {
        "enum": [
          "descenso",
          "cross_country",
          "urbano"
        ],
        "type": "string"
      },
      "UpdateTrailDto": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailStatus"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "",
    "title": "Ciudad Enduro API",
    "version": "0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/admin/trails": {
      "get": {
        "operationId": "TrailListsController_queue",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TrailStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/QueueTrailDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          },
          "403": {
            "description": "Not an admin"
          }
        },
        "tags": [
          "trails"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "Health"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "MeController_get",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/me/trails": {
      "get": {
        "operationId": "TrailListsController_mine",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/MyTrailDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "No valid session"
          }
        },
        "tags": [
          "trails"
        ]
      }
    },
    "/api/trails": {
      "get": {
        "operationId": "TrailsController_list",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/City"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/TrailSummaryDto"
                  },
                  "type": "array"
                }
              }
            },
            "description": ""
          }
        },
        "tags": [
          "trails"
        ]
      },
      "post": {
        "operationId": "TrailsController_create",
        "parameters": [],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrailBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrailDetailDto"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "GPX_* or SLUG_EMPTY, or a validation error"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "GPX_DUPLICATE (slug only when visible to the uploader) or SLUG_TAKEN"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBodyDto"
                }
              }
            },
            "description": "TOO_MANY_UPLOADS: a non-admin made 10 attempts in 10 min; TOO_MANY_PENDING: a non-admin already has 3 drafts"
          }
        },
        "tags": [
          "trails"
        ]
      }
    },
    "/api/trails/{slug}": {
      "get": {
        "operationId": "TrailsController_get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrailDetailDto"
                }
              }
            },
            "description": ""
          },
          "404": {
            "description": "No published trail has this slug (an admin gets every trail, an author also their own drafts and hidden trails)"
          }
        },
        "tags": [
          "trails"
        ]
      },
      "patch": {
        "operationId": "TrailsController_update",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateTrailDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrailDetailDto"
                }
              }
            },
            "description": ""
          },
          "404": {
            "description": "No trail has this slug"
          }
        },
        "tags": [
          "trails"
        ]
      }
    }
  },
  "servers": [],
  "tags": []
}
