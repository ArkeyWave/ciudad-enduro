{
  "components": {
    "schemas": {
      "City": {
        "enum": [
          "Chimbote",
          "Nuevo Chimbote",
          "Trujillo"
        ],
        "type": "string"
      },
      "CoordinatesDto": {
        "properties": {
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lng"
        ],
        "type": "object"
      },
      "CreatePhotoBody": {
        "properties": {
          "lat": {
            "description": "The phone position (accuracy ≤ 30 m, age ≤ 10 s); else the EXIF GPS",
            "type": "string"
          },
          "lng": {
            "type": "string"
          },
          "photo": {
            "description": "One JPEG, PNG or WebP, at most 10 MiB",
            "format": "binary",
            "type": "string"
          }
        },
        "required": [
          "photo"
        ],
        "type": "object"
      },
      "CreateTrailBody": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "description": {
            "maxLength": 2000,
            "type": "string"
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "gpx": {
            "description": "One GPX file, at most 10 MiB",
            "format": "binary",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "name",
          "city",
          "difficulty",
          "type",
          "gpx"
        ],
        "type": "object"
      },
      "Difficulty": {
        "enum": [
          "facil",
          "intermedio",
          "dificil"
        ],
        "type": "string"
      },
      "ErrorBodyDto": {
        "properties": {
          "code": {
            "example": "TOO_MANY_PENDING",
            "type": "string"
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "slug": {
            "description": "GPX_DUPLICATE only, when the uploader may see that trail",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "MeDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ],
        "type": "object"
      },
      "MyTrailDto": {
        "properties": {
          "city": {
            "allOf": [
              {
                "$ref": "#/components/schemas/City"
              }
            ]
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Difficulty"
              }
            ]
          },
          "distanceM": {
            "nullable": true,
            "type": "number"
          },
          "elevationGainM": {
            "nullable": true,
            "type": "number"
          },
          "elevationLossM": {
            "nullable": true,
            "type": "number"
          },
          "elevationProfile": {
            "description": "[distance_m, ele_m] pairs, at most 300",
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "nullable": true,
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "start": {
            "$ref": "#/components/schemas/CoordinatesDto"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailStatus"
              }
            ]
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TrailType"
              }
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "city",
          "difficulty",
          "type",
          "start",
          "distanceM",
          "elevationGainM",
          "elevationLossM",
          "elevationProfile",
          "status"
        ],
        "type": "object"
      },
      "PhotoDto": {
        "properties": {
          "heading": {
            "description": "Degrees from north (EXIF GPSImgDirection)",
            "nullable": true,
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "lineFraction": {
            "description": "0 at the trail start, 1 at its end",
