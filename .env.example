# Local development database (docker-compose.dev.yml, host port 5434)
DATABASE_URL=postgres://postgres:postgres@localhost:5434/ciudad_enduro
# Suffix for the per-worktree test database ciudad_enduro_test_<suffix>
TEST_DB_SUFFIX=main
# Base URL the web app uses to reach the API server-side
API_INTERNAL_URL=http://localhost:3001
